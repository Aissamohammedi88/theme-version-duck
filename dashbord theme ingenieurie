// ═══════════════════════════════════════════════════════════
// DRAW CHART
// ═══════════════════════════════════════════════════════════
function drawChart(){
var rect = canvas.getBoundingClientRect();
var W = rect.width, H = rect.height;
var pad = { l: 60, r: 20, t: 20, b: 40 };
var cw = W - pad.l - pad.r;
var ch = H - pad.t - pad.b;

ctx.clearRect(0, 0, W, H);

// Background grid
ctx.strokeStyle = 'rgba(26,58,92,0.4)';
ctx.lineWidth = 1;
for (var i = 0; i <= 5; i++){
var y = pad.t + ch * i / 5;
ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(pad.l + cw, y); ctx.stroke();
}
for (var i = 0; i <= 10; i++){
var x = pad.l + cw * i / 10;
ctx.beginPath(); ctx.moveTo(x, pad.t); ctx.lineTo(x, pad.t + ch); ctx.stroke();
}

// Y labels
ctx.fillStyle = '#4a6b8a';
ctx.font = '10px monospace';
ctx.textAlign = 'right';
ctx.textBaseline = 'middle';
for (var i = 0; i <= 5; i++){
var y = pad.t + ch * i / 5;
ctx.fillText(Math.round(100 * (5 - i) / 5) + '%', pad.l - 8, y);
}

// Data
var data = STATE.history;
if (!data.cpu || data.cpu.length < 2) return;

var points = Math.min(STATE.maxPoints, data.cpu.length);
var start = data.cpu.length - points;

// Compute dynamic max
var maxVal = 100;
var netMax = Math.max.apply(null, data.net_in.slice(start).concat([1]));
var tempMax = 120;

var stepX = cw / (points - 1);

// X labels (temps)
ctx.textAlign = 'center';
ctx.textBaseline = 'top';
for (var i = 0; i <= 5; i++){
var idx = start + Math.floor(points * i / 5);
idx = Math.min(idx, data.timestamps.length - 1);
var ts = data.timestamps[idx] || '';
var timeStr = ts.slice(11, 19);
var x = pad.l + cw * i / 5;
ctx.fillText(timeStr, x, pad.t + ch + 8);
}

// Draw each series
var series = ['cpu', 'ram', 'disk', 'net_in', 'net_out', 'temp'];
series.forEach(function(key){
if (!STATE.visible[key]) return;
var values = data[key].slice(start);
var color = STATE.colors[key];
var scale = 100;
if (key === 'net_in' || key === 'net_out') scale = Math.max(netMax, 10);
else if (key === 'temp') scale = tempMax;

// Area fill
ctx.beginPath();
ctx.moveTo(pad.l, pad.t + ch);
for (var i = 0; i < values.length; i++){
var x = pad.l + i * stepX;
var v = Math.min(values[i] || 0, scale);
var y = pad.t + ch - (v / scale) * ch;
ctx.lineTo(x, y);
}
ctx.lineTo(pad.l + cw, pad.t + ch);
ctx.closePath();
var grad = ctx.createLinearGradient(0, pad.t, 0, pad.t + ch);
grad.addColorStop(0, color + '40');
grad.addColorStop(1, color + '00');
ctx.fillStyle = grad;
ctx.fill();

// Line
ctx.beginPath();
ctx.strokeStyle = color;
ctx.lineWidth = 2;
ctx.shadowBlur = 8;
ctx.shadowColor = color;
for (var i = 0; i < values.length; i++){
var x = pad.l + i * stepX;
var v = Math.min(values[i] || 0, scale);
var y = pad.t + ch - (v / scale) * ch;
if (i === 0) ctx.moveTo(x, y);
else ctx.lineTo(x, y);
}
ctx.stroke();
ctx.shadowBlur = 0;

// Last value dot
if (values.length > 0){
var lastX = pad.l + (values.length - 1) * stepX;
var lastY = pad.t + ch - (Math.min(values[values.length-1], scale) / scale) * ch;
ctx.beginPath();
ctx.arc(lastX, lastY, 4, 0, Math.PI * 2);
ctx.fillStyle = color;
ctx.shadowBlur = 12;
ctx.shadowColor = color;
ctx.fill();
ctx.shadowBlur = 0;
}
});

// Hover line
if (STATE.hoverX !== null && STATE.hoverX >= pad.l && STATE.hoverX <= pad.l + cw){
ctx.strokeStyle = 'rgba(0,212,255,0.5)';
ctx.lineWidth = 1;
ctx.setLineDash([4, 4]);
ctx.beginPath();
ctx.moveTo(STATE.hoverX, pad.t);
ctx.lineTo(STATE.hoverX, pad.t + ch);
ctx.stroke();
ctx.setLineDash([]);
}
}

// ═══════════════════════════════════════════════════════════
// INTERACTION
// ═══════════════════════════════════════════════════════════
canvas.addEventListener('mousemove', function(e){
var rect = canvas.getBoundingClientRect();
var mouseX = e.clientX - rect.left;
var pad = { l: 60, r: 20 };
var cw = rect.width - pad.l - pad.r;
var data = STATE.history;
if (!data.cpu || data.cpu.length < 2){ return; }

var points = Math.min(STATE.maxPoints, data.cpu.length);
var start = data.cpu.length - points;
var stepX = cw / (points - 1);

if (mouseX >= pad.l && mouseX <= pad.l + cw){
STATE.hoverX = mouseX;
var idx = Math.round((mouseX - pad.l) / stepX);
idx = Math.max(0, Math.min(idx, points - 1));
var dataIdx = start + idx;

showTooltip(e.clientX, e.clientY, dataIdx);
} else {
STATE.hoverX = null;
hideTooltip();
}
drawChart();
});

canvas.addEventListener('mouseleave', function(){
STATE.hoverX = null;
hideTooltip();
drawChart();
});

function showTooltip(mouseX, mouseY, idx){
var tt = document.getElementById('tooltip');
var data = STATE.history;
var ts = (data.timestamps[idx] || '').slice(11, 19);
var html = '<div class="tt-time">⏱ ' + ts + '</div>';
var series = ['cpu', 'ram', 'disk', 'net_in', 'net_out', 'temp'];
var labels = { cpu: 'CPU', ram: 'RAM', disk: 'Disk', net_in: 'Net ↓', net_out: 'Net ↑', temp: 'Temp' };
series.forEach(function(key){
if (!STATE.visible[key]) return;
var v = data[key][idx] || 0;
var unit = (key === 'net_in' || key === 'net_out') ? ' KB/s' : (key === 'temp' ? ' °C' : ' %');
html += '<div class="tt-row"><span class="tt-label" style="color:' + STATE.colors[key] + '">' + labels[key] + '</span><span class="tt-value">' + v + unit + '</span></div>';
});
tt.innerHTML = html;
tt.style.display = 'block';
var tw = tt.offsetWidth;
var th = tt.offsetHeight;
var x = mouseX + 15;
var y = mouseY + 15;
if (x + tw > window.innerWidth) x = mouseX - tw - 15;
if (y + th > window.innerHeight) y = mouseY - th - 15;
tt.style.left = x + 'px';
tt.style.top = y + 'px';
}

function hideTooltip(){
document.getElementById('tooltip').style.display = 'none';
}

