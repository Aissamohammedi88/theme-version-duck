# SYSTEM METRICS
# ══════════════════════════════════════════════════════════════════════════════
class SystemMetrics:

MAX_HISTORY = 300

def __init__(self):
self.history = {
"cpu": deque(maxlen=self.MAX_HISTORY),
"ram": deque(maxlen=self.MAX_HISTORY),
"disk": deque(maxlen=self.MAX_HISTORY),
"net_in": deque(maxlen=self.MAX_HISTORY),
"net_out": deque(maxlen=self.MAX_HISTORY),
"temp": deque(maxlen=self.MAX_HISTORY),
"timestamps": deque(maxlen=self.MAX_HISTORY),
}
self.last_net = self._net_stats()
self.last_net_time = time.time()
self.lock = threading.Lock()
self._last_cpu = None

def _read(self, path):
try:
return Path(path).read_text().strip()
except Exception:
return ""

def _net_stats(self):
stats = {"rx": 0, "tx": 0}
try:
for line in self._read("/proc/net/dev").split("\n")[2:]:
if ":" not in line:
continue
iface, data = line.split(":", 1)
if iface.strip() == "lo":
continue
parts = data.split()
if len(parts) >= 9:
stats["rx"] += int(parts[0])
stats["tx"] += int(parts[8])
except Exception:
pass
return stats

def cpu_usage(self):
try:
with open("/proc/stat") as f:
line = f.readline()
values = [int(x) for x in line.split()[1:]]
idle = values[3]
total = sum(values)
if self._last_cpu is None:
self._last_cpu = (idle, total)
return 0
last_idle, last_total = self._last_cpu
delta_idle = idle - last_idle
delta_total = total - last_total
self._last_cpu = (idle, total)
if delta_total == 0:
return 0
return round(100 * (1 - delta_idle / delta_total), 1)
except Exception:
return 0

def ram_usage(self):
try:
info_d = {}
for line in self._read("/proc/meminfo").split("\n"):
if ":" in line:
k, v = line.split(":", 1)
info_d[k.strip()] = v.strip()
total = int(info_d.get("MemTotal", "0").split()[0])
available = int(info_d.get("MemAvailable", "0").split()[0])
if total == 0:
return 0, 0, 0
used = total - available
return round(100 * used / total, 1), round(used / 1024 / 1024, 2), round(total / 1024 / 1024, 2)
except Exception:
return 0, 0, 0

def disk_usage(self):
try:
import shutil
total, used, free = shutil.disk_usage("/")
return round(100 * used / total, 1), round(used / 1024**3, 2), round(total / 1024**3, 2)
except Exception:
return 0, 0, 0

def network_rate(self):
now = time.time()
current = self._net_stats()
dt = now - self.last_net_time
if dt < 0.5:
return 0, 0
rx = (current["rx"] - self.last_net["rx"]) / dt
tx = (current["tx"] - self.last_net["tx"]) / dt
self.last_net = current
self.last_net_time = now
return round(rx / 1024, 1), round(tx / 1024, 1)

def temperature(self):
try:
for zone in Path("/sys/class/thermal").glob("thermal_zone*"):
f = zone / "temp"
if f.exists():
return round(int(f.read_text().strip()) / 1000, 1)
except Exception:
pass
return 0

def collect(self):
with self.lock:
cpu = self.cpu_usage()
ram_pct, ram_used, ram_total = self.ram_usage()
disk_pct, disk_used, disk_total = self.disk_usage()
net_in, net_out = self.network_rate()
temp = self.temperature()

ts = datetime.now().isoformat()
self.history["cpu"].append(cpu)
self.history["ram"].append(ram_pct)
self.history["disk"].append(disk_pct)
self.history["net_in"].append(net_in)
self.history["net_out"].append(net_out)
self.history["temp"].append(temp)
self.history["timestamps"].append(ts)

return {
"cpu": cpu,
"ram_pct": ram_pct,
"ram_used_gb": ram_used,
"ram_total_gb": ram_total,
"disk_pct": disk_pct,
"disk_used_gb": disk_used,
"disk_total_gb": disk_total,
"net_in_kbs": net_in,
"net_out_kbs": net_out,
"temp_c": temp,
"timestamp": ts,
"history": {
"cpu": list(self.history["cpu"]),
"ram": list(self.history["ram"]),
"disk": list(self.history["disk"]),
"net_in": list(self.history["net_in"]),
"net_out": list(self.history["net_out"]),
"temp": list(self.history["temp"]),
"timestamps": list(self.history["timestamps"]),
},
}

def system_info(self):
try:
uptime = float(self._read("/proc/uptime").split()[0])
days = int(uptime // 86400)
hours = int((uptime % 86400) // 3600)
mins = int((uptime % 3600) // 60)
secs = int(uptime % 60)
if days > 0:
uptime_str = str(days) + "d " + str(hours) + "h " + str(mins) + "m"
elif hours > 0:
uptime_str = str(hours) + "h " + str(mins) + "m"
else:
uptime_str = str(mins) + "m " + str(secs) + "s"
boot = datetime.fromtimestamp(time.time() - uptime).strftime("%Y-%m-%d %H:%M:%S")
except Exception:
uptime_str = "?"
boot = "?"

return {
"hostname": socket.gethostname(),
"platform": platform.system(),
"platform_release": platform.release(),
"architecture": platform.machine(),
"processor": platform.processor() or "N/A",
"python_version": sys.version.split()[0],
"cpu_count": os.cpu_count() or 1,
"boot_time": boot,
"uptime": uptime_str,
}


METRICS = SystemMetrics()


