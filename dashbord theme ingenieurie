# HTTP HANDLER
# ══════════════════════════════════════════════════════════════════════════════
class Handler(http.server.BaseHTTPRequestHandler):

def log_message(self, *a):
pass

def _send(self, code, body, ctype="text/html; charset=utf-8"):
if isinstance(body, str):
body = body.encode("utf-8")
self.send_response(code)
self.send_header("Content-Type", ctype)
self.send_header("Content-Length", str(len(body)))
self.send_header("Cache-Control", "no-cache, no-store, must-revalidate")
self.send_header("Access-Control-Allow-Origin", "*")
self.end_headers()
try:
self.wfile.write(body)
except Exception:
pass

def do_GET(self):
import urllib.parse
p = urllib.parse.urlparse(self.path)
path = p.path

if path in ("/", "/index.html"):
self._send(200, PAGE)
elif path == "/api/metrics":
self._send(200, json.dumps(METRICS.collect()), "application/json; charset=utf-8")
elif path == "/api/info":
self._send(200, json.dumps(METRICS.system_info()), "application/json; charset=utf-8")
elif path == "/api/health":
self._send(200, json.dumps({"status": "ok", "version": "2.0.0"}), "application/json")
else:
self._send(404, json.dumps({"error": "not_found"}), "application/json")


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
daemon_threads = True
allow_reuse_address = True


def local_ip():
try:
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
s.connect(("8.8.8.8", 80))
ip = s.getsockname()[0]; s.close()
return ip
except Exception:
return "127.0.0.1"


