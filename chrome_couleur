# ─── LOGIQUE DU SERVEUR HTTP ───
handle_request() {
    local request_line
    read -r request_line
    
    # Extraire le chemin de la requête (ex: GET / HTTP/1.1)
    local path
    path=$(echo "$request_line" | awk '{print $2}')
    
    # Nettoyer la requête (lire le reste des headers jusqu'à la ligne vide)
    while IFS= read -r line && [[ -n "$line" && "$line" != $'\r' ]]; do :; done

    if [[ "$path" == "/" || "$path" == "/index.html" ]]; then
        local len
        len=$(wc -c < "$HTML_FILE")
        printf 'HTTP/1.1 200 OK\r\n'
        printf 'Content-Type: text/html; charset=utf-8\r\n'
        printf 'Content-Length: %d\r\n' "$len"
        printf 'Connection: close\r\n'
        printf '\r\n'
        cat "$HTML_FILE"
    else
        printf 'HTTP/1.1 404 Not Found\r\n'
        printf 'Content-Type: text/plain\r\n'
        printf 'Connection: close\r\n'
        printf '\r\n'
        printf '404 Not Found'
    fi
}

export -f handle_request
export HTML_FILE

# ─── LANCEMENT DU SERVEUR ───
echo -e "\033[1;36m╔══════════════════════════════════════════════════════════════╗\033[0m"
