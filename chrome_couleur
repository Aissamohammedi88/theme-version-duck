echo -e "  \033[1;32m[✓]\033[0m Port   : $PORT"
echo -e "  \033[1;32m[✓]\033[0m URL    : \033[4mhttp://localhost:$PORT\033[0m"
echo -e "\n  \033[1;33mCtrl+C pour arrêter le serveur.\033[0m\n"

# Trap pour nettoyer proprement à la sortie
trap 'echo -e "\n\033[1;31m[✗] Serveur arrêté.\033[0m"; rm -f "$HTML_FILE"; exit 0' INT TERM

# Ouvrir le navigateur automatiquement (si disponible)
if command -v xdg-open >/dev/null 2>&1; then
    sleep 1
    xdg-open "http://localhost:$PORT" &
fi

# Boucle du serveur
if [[ "$SERVER_CMD" == "socat" ]]; then
    socat TCP-LISTEN:$PORT,reuseaddr,fork EXEC:"bash -c 'handle_request'"
else
    # Fallback pour netcat (plus basique, mono-client)
    while true; do
        nc -l -p $PORT -c "bash -c 'handle_request'" 2>/dev/null || \
        (nc -l -p $PORT < /dev/null | bash -c 'handle_request')
    done
fi
